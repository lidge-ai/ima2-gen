---
import { t, type Lang } from '../i18n/strings';
import DesktopDownload from './DesktopDownload.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const facts = [1, 2, 3, 4].map((n) => ({ title: t(lang, `desktop.f${n}.t`), body: t(lang, `desktop.f${n}.b`) }));
// Labels from the real tray menu (desktop/lib/tray.mjs menuTemplate).
const tray: Array<string | null> = [
  'Show Status', 'Open ima2', 'Open in Browser', 'Open Generated Folder', null,
  'Start at Login', 'Restart Server', 'Open Server Log', null,
  'Check for Updates…', 'Settings…', null, 'Quit ima2',
];
---

<section class="std desktop-app" id="desktop">
  <div class="frame">
    <div class="section-tag reveal" style="--i:0">{t(lang, 'desktop.tag')}</div>
    <h2 class="desktop-heading chrome-text reveal" style="--i:1">{t(lang, 'desktop.h.before')}<span>{t(lang, 'desktop.h.em')}</span></h2>
    <p class="section-lede reveal" style="--i:2">{t(lang, 'desktop.lede')}</p>
    <div class="reveal" style="--i:3"><DesktopDownload lang={lang} /></div>
    <div class="desktop-grid">
      <div class="desktop-copy reveal" style="--i:4">
        <ul class="desktop-facts">
          {facts.map((fact) => (
            <li><strong>{fact.title}</strong><span>{fact.body}</span></li>
          ))}
        </ul>
        <p class="desktop-platform-line">{t(lang, 'desktop.platforms')}</p>
      </div>
      <figure class="tray-mock reveal" style="--i:5" aria-label={t(lang, 'desktop.tray.aria')}>
        <div class="tray-bar" aria-hidden="true"><span class="tray-icon"></span></div>
        <ul class="tray-menu" role="menu" aria-label={t(lang, 'desktop.tray.aria')}>
          <li class="tray-status" role="presentation">{t(lang, 'desktop.tray.status')}</li>
          <li class="tray-sep" role="separator"></li>
          {tray.map((label) => label === null
            ? <li class="tray-sep" role="separator"></li>
            : label === 'Start at Login'
              ? <li class="is-checked" role="menuitemcheckbox" aria-checked="true">{label}</li>
              : <li role="menuitem">{label}</li>)}
        </ul>
      </figure>
    </div>
  </div>
</section>

<style>
  .desktop-app { position: relative; overflow: clip; background: var(--bg-soft); }
  .desktop-heading { max-width: 1000px; margin: 18px 0 22px; font: 600 56px/.98 var(--font-display); letter-spacing: 0; text-wrap: balance; }
  .desktop-heading span { display: block; }
  .desktop-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr); gap: 72px; align-items: start; }
  .desktop-facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
  .desktop-facts li { display: flex; flex-direction: column; gap: 8px; padding: 22px 0; border-top: 1px solid var(--line); }
  .desktop-facts strong { font: 600 18px/1.25 var(--font-display); }
  .desktop-facts span { color: var(--text-dim); font-size: 15px; line-height: 1.6; }
  .desktop-platform-line { margin: 18px 0 0; color: var(--text-dim); font: 500 11px/1.7 var(--font-mono); letter-spacing: .04em; }
  .tray-mock { margin: 0; justify-self: end; width: min(100%, 330px); }
  .tray-bar { display: flex; justify-content: flex-end; padding: 6px 12px; border: 1px solid var(--glass-line); border-bottom: 0; border-radius: 10px 10px 0 0; background: rgba(255, 255, 255, .04); }
  .tray-icon { width: 14px; height: 14px; border-radius: 3px; background: var(--prism); }
  .tray-menu { list-style: none; margin: 0; padding: 6px; border: 1px solid var(--glass-line); border-radius: 0 0 10px 10px; background: var(--panel); box-shadow: 0 28px 80px rgba(0, 0, 0, .5); font: 400 13px/1 var(--font-body); }
  .tray-menu li { padding: 7px 12px 7px 28px; border-radius: 5px; color: var(--text); }
  .tray-menu li:hover { background: rgba(255, 255, 255, .06); }
  .tray-menu .tray-status { color: var(--text-dim); font: 500 11px/1.4 var(--font-mono); }
  .tray-menu .tray-status:hover { background: none; }
  .tray-menu .is-checked { position: relative; }
  .tray-menu .is-checked::before { content: '✓'; position: absolute; left: 11px; color: var(--text-dim); }
  .tray-menu .tray-sep { height: 1px; margin: 5px 8px; padding: 0; background: var(--line); }
  .tray-menu .tray-sep:hover { background: var(--line); }
  @media (max-width: 900px) {
    .desktop-heading { font-size: 44px; }
    .desktop-grid { grid-template-columns: 1fr; gap: 44px; }
    .tray-mock { justify-self: start; }
  }
  @media (max-width: 560px) {
    .desktop-heading { font-size: 34px; }
    .desktop-facts { grid-template-columns: 1fr; }
  }
</style>
