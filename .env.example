# ima2-gen runtime configuration (see config.js).
# Copy to .env or export in your shell. All keys are optional; defaults live in config.js.
# Priority: env var > ${IMA2_CONFIG_DIR}/config.json > built-in default.

# ── Server ─────────────────────────────────────────────────────────────
# IMA2_PORT=3333            # also accepted: PORT
# IMA2_HOST=127.0.0.1
# Non-loopback access requires your own strong, private token (never commit it).
# IMA2_LAN_TOKEN=
# Exact serving origins for a TLS proxy, LAN DNS name or changed Docker port:
# IMA2_PUBLIC_ORIGINS=["https://studio.example"]
# IMA2_BODY_LIMIT=50mb

# ── GPT OAuth (in-process client for chatgpt.com/backend-api/codex) ───
# IMA2_CODEX_CLIENT_VERSION=     # Codex client version sent to ChatGPT (default: latest @openai/codex, at least 0.157.0)
# IMA2_NO_OAUTH_PROXY=1         # send GPT OAuth calls to an external OpenAI-compatible endpoint instead (tests / CI)
# IMA2_OAUTH_PROXY_PORT=10531   # that endpoint's port on 127.0.0.1; also accepted: OAUTH_PORT
# IMA2_OAUTH_STATUS_TIMEOUT_MS=3000
# IMA2_OAUTH_RESTART_DELAY_MS=5000
# IMA2_RESEARCH_SUFFIX="..."    # appended to every image prompt

# ── Paths ──────────────────────────────────────────────────────────────
# IMA2_CONFIG_DIR=/custom/path  # defaults to ~/.ima2
# IMA2_DB_PATH=/custom/sessions.db
# IMA2_GENERATED_DIR=/custom/generated
# IMA2_TRASH_DIR=/custom/generated/.trash
# IMA2_ADVERTISE_FILE=/custom/server.json
# IMA2_STATIC_MAX_AGE=1y

# ── Limits ─────────────────────────────────────────────────────────────
# IMA2_MAX_REF_B64_BYTES=7340032   # ~5.2MB decoded
# IMA2_MAX_REF_COUNT=5
# IMA2_MAX_PARALLEL=8
# IMA2_HISTORY_PAGE_SIZE=50
# IMA2_HISTORY_MAX_PAGE=500
# IMA2_GRAPH_MAX_NODES=500
# IMA2_GRAPH_MAX_EDGES=1000

# ── ComfyUI bridge ────────────────────────────────────────────────────
# IMA2_COMFY_URL=http://127.0.0.1:8188
# IMA2_COMFY_UPLOAD_TIMEOUT_MS=30000
# IMA2_COMFY_MAX_UPLOAD_BYTES=52428800

# ── IDs & TTLs ─────────────────────────────────────────────────────────
# IMA2_GENERATED_HEX_BYTES=4
# IMA2_NODE_HEX_BYTES=5
# IMA2_INFLIGHT_TTL_MS=600000
# IMA2_INFLIGHT_REAP_MS=60000
# IMA2_TRASH_TTL_MS=10000

# ── Style sheet (0.10) ─────────────────────────────────────────────────
# IMA2_STYLE_SHEET_MAX_PREFIX=4000
# IMA2_STYLE_MODEL=gpt-5.4-mini

# ── Logging ────────────────────────────────────────────────────────────
# IMA2_LOG_LEVEL=info    # trace|debug|info|warn|error|fatal

# Explicit doctor checks only; defaults in milliseconds, maximum 30000.
# --verify-keys checks remote authentication without generating images.
# IMA2_DIAGNOSTIC_KEY_TIMEOUT_MS=5000
# --runtime requires an explicit loopback server origin.
# IMA2_DIAGNOSTIC_RUNTIME_TIMEOUT_MS=1500

# ── Secrets (not merged from config.json, env only) ────────────────────
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
# GEMINI_API_KEY=AI...
# ATLASCLOUD_API_KEY=apikey-...
# MINIMAX_API_KEY=...            # MiniMax image generation (image-01 / image-01-live)

# ── MiniMax image provider ─────────────────────────────────────────────
# IMA2_MINIMAX_REGION=global_en  # global_en (default) | cn_zh
# IMA2_MINIMAX_GLOBAL_BASE_URL=https://api.minimax.io/v1
# IMA2_MINIMAX_CN_BASE_URL=https://api.minimaxi.com/v1
# IMA2_MINIMAX_IMAGE_MODEL_DEFAULT=image-01
# IMA2_MINIMAX_GENERATION_TIMEOUT_MS=120000
